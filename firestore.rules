rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    // Role check: in demo, officer custom claim or client authentication is checked
    // Private reports are restricted to officer role or admin claims
    function isOfficer() {
      return isAuthenticated() && (request.auth.token.role == 'officer' || request.auth.token.officer == true);
    }

    // Ponds: Farmers own and manage their own ponds
    match /ponds/{pondId} {
      allow read, write: if isAuthenticated();

      match /water_readings/{readingId} {
        allow read, write: if isAuthenticated();
      }
    }

    // Public reports: Anonymized (~500m grid), read access for all authenticated users (farmers & officers)
    // Write access allowed for authenticated users submitting reports
    match /reports_public/{reportId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // Private reports: Exact coordinates and user IDs. Restricted to officer read only.
    // Submitting user can create their own record.
    match /reports_private/{reportId} {
      allow read: if isOfficer();
      allow create: if isAuthenticated();
      allow update, delete: if isOfficer();
    }

    // Alerts: Generated by client clustering, read by all farmers and officers
    match /alerts/{alertId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }
  }
}
